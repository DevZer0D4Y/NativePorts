--- /dev/null
+++ b/src/devices/cpu/mips/showtimecopy.h
@@ -0,0 +1,35 @@
+// license:BSD-3-Clause
+// Signature-checked Showtime byte-copy loop support. No game clocks change.
+#ifndef MAME_CPU_MIPS_SHOWTIMECOPY_H
+#define MAME_CPU_MIPS_SHOWTIMECOPY_H
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+inline unsigned showtime_copy_count(uint64_t counter, uint64_t terminal, int cycles)
+{
+    // v1 starts at length-1; a2 is -1. Leave the last iteration to the
+    // interpreter so its fall-through and delay-slot path remain ordinary.
+    if (terminal != UINT64_MAX || counter == 0 || counter >= 0x800000 || cycles < 6)
+        return 0;
+    return std::min(unsigned(counter), unsigned(cycles / 6));
+}
+
+inline void showtime_copy_iterations(uint8_t *dst, const uint8_t *src,
+                                    unsigned n, uint64_t *r, int &cycles)
+{
+    if (!n) return;
+    uintptr_t d = reinterpret_cast<uintptr_t>(dst), s = reinterpret_cast<uintptr_t>(src);
+    // The guest copies forwards, including overlapping copies with dst>src.
+    // memmove alone would change that case's propagated byte pattern.
+    if (d > s && d - s < n)
+        for (unsigned i = 0; i < n; ++i) dst[i] = src[i];
+    else if (d != s)
+        std::memmove(dst, src, n);
+    r[2] = dst[n - 1];
+    r[3] = uint64_t(int64_t(int32_t(uint32_t(r[3]) - n)));
+    r[4] = uint64_t(int64_t(int32_t(uint32_t(r[4]) + n)));
+    r[5] = uint64_t(int64_t(int32_t(uint32_t(r[5]) + n)));
+    cycles -= int(n * 6);
+}
+#endif
