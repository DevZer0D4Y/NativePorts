+
+/* Widescreen: everything is drawn 3/4 as wide around the centre of the drawing
+   area, and the frontend shows the frame at 16:9. Pictures keep their
+   proportions; in 3D scenes the geometry the game draws beyond the edges of its
+   4:3 screen fills the sides. Rectangles become quads so they can be narrowed;
+   full-width rectangles (screen clears and fills) are left as they are.
+   Movies and screens uploaded as whole pictures have no geometry to widen, so
+   widescreen engages only while the game draws 3D scenes. */
+int gpu_widescreen, gpu_widescreen_active;
+static unsigned gpu_frame_prims, gpu_recent_prims[8], gpu_recent_slot;
+
+/* Called once per emulated frame: 3D scenes draw hundreds of primitives. */
+void gpu_widescreen_end_frame(void)
+{
+  unsigned i, sum = 0;
+  gpu_recent_prims[gpu_recent_slot] = gpu_frame_prims;
+  gpu_recent_slot = (gpu_recent_slot + 1) & 7;
+  gpu_frame_prims = 0;
+  for (i = 0; i < 8; i++)
+    sum += gpu_recent_prims[i];
+  if (sum >= 600)
+    gpu_widescreen_active = 1;
+  else if (sum < 150)
+    gpu_widescreen_active = 0;
+}
+
+static s32 narrow_x(psx_gpu_struct *psx_gpu, s32 x)
+{
+  s32 centre = (psx_gpu->viewport_start_x + psx_gpu->viewport_end_x + 1) / 2;
+  x += psx_gpu->offset_x;
+  return centre + (((x - centre) * 3) >> 2) - psx_gpu->offset_x;
+}
+
+static void narrow_vertex(psx_gpu_struct *psx_gpu, u32 *w)
+{
+  s32 x = narrow_x(psx_gpu, sign_extend_11bit(*w & 0xffff));
+  *w = (*w & 0xffff0000) | (x & 0xffff);
+}
+
+/* Rewrites one command in place for widescreen; returns its new command byte. */
+static u32 narrow_command(psx_gpu_struct *psx_gpu, u32 *prim, const u32 *list,
+ u32 command, u32 *ex_regs)
+{
+  if (command >= 0x20 && command < 0x40)
+  {
+    int stride = 1 + ((command & 4) ? 1 : 0) + ((command & 0x10) ? 1 : 0);
+    int count = (command & 8) ? 4 : 3, k;
+    for (k = 0; k < count; k++)
+      narrow_vertex(psx_gpu, &prim[1 + k * stride]);
+    return command;
+  }
+  if (command >= 0x60 && command < 0x80 && command_lengths[command])
+  {
+    static const u8 sizes[4] = { 0, 1, 8, 16 };
+    int textured = command & 4, size = sizes[(command >> 3) & 3];
+    s32 x = sign_extend_11bit(list[1] & 0xffff), y = (s16)(list[1] >> 16), x0, x1;
+    u32 w = size, h = size, u = 0, v = 0, clut = 0;
+    if (!size)
+    {
+      u32 wh = list[textured ? 3 : 2];
+      w = wh & 0x3ff; h = (wh >> 16) & 0x1ff;
+    }
+    if (textured)
+    {
+      u = list[2] & 0xff; v = (list[2] >> 8) & 0xff; clut = list[2] >> 16;
+    }
+    if (!w || !h || (s32)w >= psx_gpu->viewport_end_x - psx_gpu->viewport_start_x - 16)
+      return command;
+    x0 = narrow_x(psx_gpu, x) & 0xffff;
+    x1 = narrow_x(psx_gpu, x + w) & 0xffff;
+    if (textured)
+    {
+      u32 u1 = u + w > 255 ? 255 : u + w, v1 = v + h > 255 ? 255 : v + h;
+      prim[0] = (list[0] & 0x03ffffff) | 0x2C000000;
+      prim[1] = x0 | ((y & 0xffff) << 16);
+      prim[2] = (clut << 16) | (v << 8) | u;
+      prim[3] = x1 | ((y & 0xffff) << 16);
+      prim[4] = ((ex_regs[1] & 0x1ff) << 16) | (v << 8) | u1;
+      prim[5] = x0 | (((y + h) & 0xffff) << 16);
+      prim[6] = (v1 << 8) | u;
+      prim[7] = x1 | (((y + h) & 0xffff) << 16);
+      prim[8] = (v1 << 8) | u1;
+      return 0x2C | (command & 3);
+    }
+    prim[0] = (list[0] & 0x02ffffff) | 0x28000000;
+    prim[1] = x0 | ((y & 0xffff) << 16);
+    prim[2] = x1 | ((y & 0xffff) << 16);
+    prim[3] = x0 | (((y + h) & 0xffff) << 16);
+    prim[4] = x1 | (((y + h) & 0xffff) << 16);
+    return 0x28 | (command & 2);
+  }
+  return command;
 }
 
