+/* Native software geometry is rendered into an expanded GPU canvas.
+   Movies keep their original drawing area and aspect. */
+int gpu_widescreen, gpu_widescreen_active;
+static unsigned gpu_frame_prims, gpu_recent_prims[8], gpu_recent_slot;
+
+/* Called once per emulated frame: 3D scenes draw hundreds of primitives. */
+void gpu_widescreen_end_frame(void)
+{
+  unsigned i, sum = 0;
+  gpu_recent_prims[gpu_recent_slot] = gpu_frame_prims;
+  gpu_recent_slot = (gpu_recent_slot + 1) & 7;
+  gpu_frame_prims = 0;
+  for (i = 0; i < 8; i++)
+    sum += gpu_recent_prims[i];
+  if (sum >= 600)
+    gpu_widescreen_active = 1;
+  else if (sum < 150)
+    gpu_widescreen_active = 0;
+}
+
+/* Slam renders software-projected coordinates, including a 64-pixel guard
+ * band. Give those native commands a wider canvas; retain sprite UVs, size,
+ * clipping and rasterization instead of converting them into texture quads. */
+static void port_draw_window(psx_gpu_struct *g, const u32 *regs, int wide)
+{
+  int left = regs[3] & 1023, right = regs[4] & 1023;
+  int full = wide && right - left == 319 && right + 106 < 1024;
+  int bank = full && left == 320 ? 192 : 0;
+  g->offset_x = sign_extend_11bit(regs[5]) + (full ? 53 : 0) + bank;
+  g->viewport_start_x = left + bank;
+  g->viewport_end_x = right + (full ? 106 : 0) + bank;
+#ifdef TEXTURE_CACHE_4BPP
+  g->viewport_mask = texture_region_mask(g->viewport_start_x,g->viewport_start_y,
+    g->viewport_end_x,g->viewport_end_y);
+#endif
+}
