 ***************************************************************************/
 
+#ifdef drv_ssf2t
+/*************************************
+ *
+ *	Super Street Fighter II Turbo widescreen
+ *
+ *************************************/
+
+/* The CPS2 video hardware draws 512-pixel rows and the game shows the 384 in the
+   middle. During a fight the whole row is shown: the stage tilemaps hold the
+   scenery around the 4:3 view and the fighters stay inside it. The camera centre
+   moves between the stage limits, so the scenery of the main layer (scroll 2)
+   ends 192 pixels beyond them; a parallax layer (scroll 3) scrolls in proportion
+   to the camera and covers less. Each layer is clipped to the columns its art
+   covers, so the tilemap's unused tiles never show. Menus stay 4:3. */
+extern data16_t *cps2_workram;
+#define SF_RAM(a)		cps2_workram[((a) - 0xff0000) >> 1]
+#define SF_P1			0xff844e		/* player objects, non-zero during a fight */
+#define SF_P2			0xff884e
+#define SF_CENTRE		0xff8ed4		/* camera centre X */
+#define SF_MIN			0xff8c54		/* camera centre limits */
+#define SF_MAX			0xff8c56
+
+#define SF_BACK			0xff803a		/* X of the parallax layer (scroll 3) */
+
+static int ssf2t_requested = 1, ssf2t_wide;
+static int ssf2t_backc, ssf2t_learned, ssf2t_knum, ssf2t_kden;
+
+void ssf2t_set_widescreen(int enable)
+{
+	ssf2t_requested = enable != 0;
+}
+
+static void ssf2t_update_widescreen(void)
+{
+	INT16 centre, lo, hi;
+	int fighting, wide;
+	if (!cps2_workram)
+		return;
+	centre = SF_RAM(SF_CENTRE); lo = SF_RAM(SF_MIN); hi = SF_RAM(SF_MAX);
+	fighting = SF_RAM(SF_P1) && SF_RAM(SF_P2) && hi > lo && centre >= lo && centre <= hi;
+	wide = ssf2t_requested && fighting;
+	if (!fighting)
+		ssf2t_learned = 0;
+	else if (centre == (lo + hi) / 2)
+	{
+		/* every round starts with the camera centred: note where the parallax layer is */
+		ssf2t_backc = (INT16)SF_RAM(SF_BACK);
+		ssf2t_learned = 1;
+		ssf2t_kden = 0;
+	}
+	else if (ssf2t_learned && abs(centre - (lo + hi) / 2) >= 24)
+	{
+		/* ...and how fast it follows the camera */
+		ssf2t_knum = (INT16)SF_RAM(SF_BACK) - ssf2t_backc;
+		ssf2t_kden = centre - (lo + hi) / 2;
+	}
+	if (wide != ssf2t_wide)
+		set_visible_area(wide ? 0 : 64, wide ? 511 : 447, Machine->visible_area.min_y, Machine->visible_area.max_y);
+	ssf2t_wide = wide;
+}
+
+/* Columns of the bitmap that a layer's art covers in widescreen: the 4:3 view
+   (columns 64-447) reaches the end of a layer's art when the camera reaches a limit. */
+static void ssf2t_layer_clip(int layer, const struct rectangle *cliprect, struct rectangle *clip)
+{
+	INT16 centre = SF_RAM(SF_CENTRE), lo = SF_RAM(SF_MIN), hi = SF_RAM(SF_MAX);
+	int mid = (lo + hi) / 2, left, right;
+	*clip = *cliprect;
+	if (!ssf2t_wide)
+		return;
+	if (layer == 2)
+	{
+		left = 64 + lo - centre;
+		right = 448 + hi - centre;
+	}
+	else if (layer == 3 && ssf2t_learned && ssf2t_kden)
+	{
+		int back = (INT16)SF_RAM(SF_BACK);
+		left = 64 + ssf2t_backc + (lo - mid) * ssf2t_knum / ssf2t_kden - back;
+		right = 448 + ssf2t_backc + (hi - mid) * ssf2t_knum / ssf2t_kden - back;
+		if (left > right) { int swap = left - 64 + 448; left = right - 448 + 64; right = swap; }
+	}
+	else
+		return;
+	if (left > clip->min_x) clip->min_x = left;
+	if (right - 1 < clip->max_x) clip->max_x = right - 1;
+	if (clip->max_x < clip->min_x) clip->max_x = clip->min_x - 1;
+}
+
+static void ssf2t_render_layer(struct mame_bitmap *bitmap, const struct rectangle *cliprect, int layer, int primask)
+{
+	struct rectangle clip;
+	ssf2t_layer_clip(layer, cliprect, &clip);
+    if (clip.max_x >= clip.min_x) {
+        int x, y;
+        cps1_render_layer(bitmap, &clip, layer, primask);
+        /* Finite stage art cannot supply new columns at the camera limit.
+         * Reflect its painted edge per layer, before fighters and the HUD,
+         * including priority so sprites still pass behind foreground art. */
+        for (y = clip.min_y; y <= clip.max_y; ++y) {
+            for (x = cliprect->min_x; x < clip.min_x; ++x) {
+                int src = clip.min_x + clip.min_x - x - 1;
+                if (src > clip.max_x) src = clip.max_x;
+                plot_pixel(bitmap,x,y,read_pixel(bitmap,src,y));
+                plot_pixel(priority_bitmap,x,y,read_pixel(priority_bitmap,src,y));
+            }
+            for (x = clip.max_x + 1; x <= cliprect->max_x; ++x) {
+                int src = clip.max_x - (x - clip.max_x - 1);
+                if (src < clip.min_x) src = clip.min_x;
+                plot_pixel(bitmap,x,y,read_pixel(bitmap,src,y));
+                plot_pixel(priority_bitmap,x,y,read_pixel(priority_bitmap,src,y));
+            }
+        }
+    }
+}
+#endif
+
