 /* workaround so comic book offer in mk is correct, without breaking text in mk2 */
 static int mk_delay = 0;
 
+#ifdef drv_umk3
+/*************************************
+ *
+ *	Ultimate Mortal Kombat 3 widescreen
+ *
+ *************************************/
+
+/* UMK3 draws into 512-pixel bitmap rows but shows only the 400 columns after a
+   56-pixel pad. Its display processor (the MK "mkdisp" object handler) culls every
+   background plane against the screen window [scrntl, scrnlr]; widening that
+   window during a fight draws the scenery that lies just off screen, and the
+   whole row is shown. The per-line floor copies come from a wider image and are
+   widened too, and rows of identical repeating tiles are continued into the new
+   columns. Fighters stay bounded by the original screen edges. Menus stay 4:3. */
+#define U3_PAD			56
+#define U3_RAM(a)		midyunit_scratch_ram[((a) - 0x01000000) >> 4]
+#define U3_ROM(a)		midyunit_code_rom[((a) - 0xff800000) >> 4]
+#define U3_SCRNTL_X		0x010608e0		/* X word of the [Y,X] window top left */
+#define U3_SCRNLR_X		0x01060900		/* X word of the window lower right */
+#define U3_P1_OBJ		0x010609d0
+#define U3_P2_OBJ		0x01061580
+
+static int umk3_requested = 1, umk3_wide, umk3_checked, umk3_supported;
+
+void umk3_set_widescreen(int enable)
+{
+	umk3_requested = enable != 0;
+}
+
+int umk3_widescreen_active(void)
+{
+	return umk3_wide;
+}
+
+/* Only the rev 1.2 program: "move @scrntl,a14,L" and "move @scrnlr,a13,L" in the display loop. */
+static int umk3_program_matches(void)
+{
+	return U3_ROM(0xff804f50) == 0x07ae && U3_ROM(0xff804f60) == 0x08e0 && U3_ROM(0xff804f70) == 0x0106 &&
+	       U3_ROM(0xff805020) == 0x07ad && U3_ROM(0xff805030) == 0x0900 && U3_ROM(0xff805040) == 0x0106;
+}
+
+static void umk3_update_widescreen(void)
+{
+	int fighting, wide;
+	if (!umk3_checked)
+	{
+		umk3_supported = umk3_program_matches();
+		umk3_checked = 1;
+	}
+	fighting = (U3_RAM(U3_P1_OBJ) | U3_RAM(U3_P1_OBJ + 0x10)) && (U3_RAM(U3_P2_OBJ) | U3_RAM(U3_P2_OBJ + 0x10));
+	wide = umk3_supported && umk3_requested && fighting;
+
+	/* screens set the default full-screen window once; convert only that window */
+	if (wide && (INT16)U3_RAM(U3_SCRNTL_X) == 0 && U3_RAM(U3_SCRNLR_X) == 400)
+	{
+		U3_RAM(U3_SCRNTL_X) = (UINT16)-U3_PAD;
+		U3_RAM(U3_SCRNLR_X) = 400 + U3_PAD;
+	}
+	else if (!wide && (INT16)U3_RAM(U3_SCRNTL_X) == -U3_PAD && U3_RAM(U3_SCRNLR_X) == 400 + U3_PAD)
+	{
+		U3_RAM(U3_SCRNTL_X) = 0;
+		U3_RAM(U3_SCRNLR_X) = 400;
+	}
+	if (wide != umk3_wide)
+		set_visible_area(0, wide ? 511 : 399, Machine->visible_area.min_y, Machine->visible_area.max_y);
+	umk3_wide = wide;
+}
+
+/* Blits of this frame, to recognise rows of identical tiles. */
+#define U3_TILES 96
+static struct { UINT32 offset; UINT16 command, palette, width, height, ypos, xpos, extended; } umk3_tiles[U3_TILES];
+static int umk3_tile_count;
+#endif
+
+static void dma_draw_current(int command)
+{
+	if (dma_state.xstep == 0x100 && dma_state.ystep == 0x100)
+	{
+		if (command & 0x80)
+			(*dma_draw_skip_noscale[command & 0x1f])();
+		else
+			(*dma_draw_noskip_noscale[command & 0x1f])();
+	}
+	else
+	{
+		if (command & 0x80)
+			(*dma_draw_skip_scale[command & 0x1f])();
+		else
+			(*dma_draw_noskip_scale[command & 0x1f])();
+	}
+}
+
+#ifdef drv_umk3
+/* A tile drawn next to an identical copy of itself (same image, size, row and
+   palette) belongs to a repeating row; continue the row into the new columns. */
+static void umk3_extend_tiles(int command)
+{
+	int i, x = dma_state.xpos, w = dma_state.width;
+	if (dma_state.xstep != 0x100 || dma_state.ystep != 0x100 || dma_state.height < 2 || w < 16 || x >= 512)
+		return;
+	for (i = 0; i < umk3_tile_count; i++)
+	{
+		int ox = umk3_tiles[i].xpos, left, right, p, saved = dma_state.xpos;
+		if (umk3_tiles[i].command != command ||
+			umk3_tiles[i].width != w || umk3_tiles[i].height != dma_state.height ||
+			umk3_tiles[i].ypos != dma_state.ypos || umk3_tiles[i].palette != dma_state.palette ||
+			(ox != x - w && ox != x + w) || umk3_tiles[i].extended)
+			continue;
+        /* A mixed tile band needs three adjacent cells; two fighters or
+         * unrelated props must never be mistaken for repeating scenery. */
+        if (umk3_tiles[i].offset != dma_state.offset) {
+            int j, third = 0, lo = ox < x ? ox : x, hi = ox > x ? ox : x;
+            for (j = 0; j < umk3_tile_count; ++j)
+                if (j != i && umk3_tiles[j].command == command &&
+                    umk3_tiles[j].palette == dma_state.palette &&
+                    umk3_tiles[j].width == w && umk3_tiles[j].height == dma_state.height &&
+                    umk3_tiles[j].ypos == dma_state.ypos &&
+                    (umk3_tiles[j].xpos == lo - w || umk3_tiles[j].xpos == hi + w))
+                    third = 1;
+            if (!third) continue;
+        }
+		umk3_tiles[i].extended = 1;
+		left = ox < x ? ox : x;
+		right = (ox > x ? ox : x) + w;
+		/* only rows that reach an original screen edge and stop short of the new one */
+		if (left > 0 && left <= U3_PAD + 8)
+			for (p = left - w; p + w > 0; p -= w)
+			{
+				dma_state.xpos = p & XPOSMASK;
+				dma_draw_current(command);
+			}
+		if (right < 512 && right >= 400 + U3_PAD - 8)
+			for (p = right; p < 512; p += w)
+			{
+				dma_state.xpos = p;
+				dma_draw_current(command);
+			}
+		dma_state.xpos = saved;
+		break;
+	}
+	/* a wide static band (sky, clouds) that ends at an original screen edge is
+	   continued with its mirror image, which keeps it seamless */
+	if (i == umk3_tile_count && w >= 200 && dma_state.height >= 8)
+	{
+		int saved = dma_state.xpos, pre = 0, post = 0;
+		if (command & 0x80)
+		{
+			/* mirror around the visible edges: compressed rows start with their skip counts */
+			UINT32 o = dma_state.offset;
+			int value = ((midyunit_gfx_rom[o >> 3] | (midyunit_gfx_rom[(o >> 3) + 1] << 8)) >> (o & 7)) & 0xff;
+			pre = (value & 0x0f) << dma_state.preskip;
+			post = ((value >> 4) & 0x0f) << dma_state.postskip;
+		}
+		if (x + pre >= U3_PAD - 8 && x + pre <= U3_PAD + 8)
+		{
+			dma_state.xpos = (x + 2 * pre - 1) & XPOSMASK;
