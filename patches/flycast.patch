+/* Keep THPS2 screen-space overlays in the centered original 4:3 region. */
+static bool thps2_hud(const PolyParam *gp)
+{
+    if (pvrrc.isRTT || !settings.rend.WidescreenGameHacks ||
+        (gp->isp.DepthMode != 4 && gp->isp.DepthMode != 7) || gp->count < 3 ||
+        (strncmp(ip_meta.product_number, "T13006N", 7) && strncmp(ip_meta.product_number, "T13008D", 7)))
+        return false;
+    const float z = pvrrc.verts.head()[pvrrc.idx.head()[gp->first]].z;
+    /* THPS2 submits fonts, meters and stance icons in a separate UI depth
+     * band (7 + a small ordering bias), using GREATER, not ALWAYS. Flat world
+     * polygons and billboards use other depths and must retain the world FOV. */
+    if (z < 6.9f || z > 8.0f) return false;
+    for (u32 i = 0; i < gp->count; ++i) {
+        const Vertex &v = pvrrc.verts.head()[pvrrc.idx.head()[gp->first + i]];
+        if (v.z != z || v.x < 0 || v.x > 640 || v.y < 0 || v.y > 480)
+            return false;
+    }
+    return true;
 }
 
