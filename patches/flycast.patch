+/* Pull the normal follow camera away from the tracked skater, before the
+ * renderer builds its view matrix. CCamera's own position is already behind
+ * the skater: scaling only its small extra offset mostly moved the picture
+ * vertically. Scale the complete eye-to-skater vector instead. */
+static bool thps2_follow_camera(u8 *ram)
+{
+    for (u32 base=0x70000;base<0x74000;base+=2) {
+        u16 *f=reinterpret_cast<u16 *>(ram+base);
+        if (f[0x8e/2]!=0xa04b || f[0x90/2]!=9 ||
+            f[0xb0/2]!=0x51c1 || f[0xb4/2]!=0x5237 ||
+            f[0xb6/2]!=0xe7f4 || f[0xb8/2]!=0x312c || f[0xba/2]!=0x417c ||
+            f[0xbc/2]!=0x1511 || f[0xc0/2]!=0x5238 ||
+            f[0xc2/2]!=0x312c || f[0xc4/2]!=0x417c || f[0xc6/2]!=0x1512 ||
+            f[0xca/2]!=0x5239 || f[0xcc/2]!=0x312c ||
+            (f[0xce/2]&0xff00)!=0x9600 || f[0xd0/2]!=0x417c || f[0xd2/2]!=0x1513 ||
+            f[0x198/2]!=0x000b || f[0x19a/2]!=9 || f[0x19c/2]!=0x03b4)
+            continue;
+        /* Compiler alignment padding after two return/literal pools. The
+         * second pool names this camera function, tying both caves to the
+         * same executable layout. Refuse either occupied region. */
+        u32 linked; memcpy(&linked,ram+base+0x380,sizeof(linked));
+        if(linked != 0x8c000000+base) continue;
+        bool cave=true;
+        for(u32 i=0x1c4/2;i<0x1e0/2;i++) if(f[i]!=9) cave=false;
+        for(u32 i=0x384/2;i<0x3a0/2;i++) if(f[i]!=9) cave=false;
+        if(!cave) continue;
+        const u16 setup[]={
+            0x900a, /* tracked-body offset literal */
+            0x00ce, /* mov.l @(r0,r12),r0 */
+            0x2008,0x8903, /* no tracked body: use original eye calculation */
+            0x006e, /* skater x/y/z selected by caller's r6 */
+            0xa0d9,9,9, /* branch to vector calculation */
+            0x312c,0x000b,0x417c,9,0x03b4
+        };
+        const u16 vector[]={
+            0x312c, /* eye = camera base + camera offset */
+            0x6213,0x3208,0x4221,0x4221, /* delta = (eye - skater) / 4 */
+            0x312c,0x000b,0x417c /* eye += delta; return converted */
+        };
+        memcpy(f+0x1c4/2,setup,sizeof(setup));
+        memcpy(f+0x384/2,vector,sizeof(vector));
+        f[0xb8/2]=0xb084;f[0xba/2]=0xe604;
+        f[0xc2/2]=0xb07f;f[0xc4/2]=0xe608;
+        f[0xd0/2]=f[0xce/2]-1; /* relocate the PC-relative r6 literal load */
+        f[0xcc/2]=0xb07a;f[0xce/2]=0xe60c;
+        return true;
+    }
+    return false;
+}
