+/* Patch the follow-camera vector before any game instructions execute.
+ * The two releases share this instruction sequence; literal offsets can differ.
+ * Only unused NOPs after an unconditional branch are used for the helper. */
+static bool thps2_follow_camera(u8 *ram)
+{
+    for (u32 base=0x70000;base<0x74000;base+=2) {
+        u16 *f=reinterpret_cast<u16 *>(ram+base);
+        if (f[0x8e/2]!=0xa04b || f[0x90/2]!=9 ||
+            f[0xb0/2]!=0x51c1 || f[0xb4/2]!=0x5237 ||
+            f[0xb6/2]!=0xe7f4 || f[0xb8/2]!=0x312c || f[0xba/2]!=0x417c ||
+            f[0xbc/2]!=0x1511 || f[0xc0/2]!=0x5238 ||
+            f[0xc2/2]!=0x312c || f[0xc4/2]!=0x417c || f[0xc6/2]!=0x1512 ||
+            f[0xca/2]!=0x5239 || f[0xcc/2]!=0x312c ||
+            (f[0xce/2]&0xff00)!=0x9600 || f[0xd0/2]!=0x417c || f[0xd2/2]!=0x1513)
+            continue;
+        bool cave=true;
+        for(u32 i=0x92/2;i<=0x9e/2;i++) if(f[i]!=9) cave=false;
+        if(!cave) continue;
+        const u16 helper[]={0x6023,0x4021,0x4021,0x320c,0x312c,0x000b,0x417c};
+        memcpy(f+0x92/2,helper,sizeof(helper));
+        f[0xb8/2]=0xbfeb;f[0xba/2]=9;
+        f[0xc2/2]=0xbfe6;f[0xc4/2]=9;
+        f[0xd0/2]=f[0xce/2]-1; /* relocate the PC-relative r6 literal load */
+        f[0xcc/2]=0xbfe1;f[0xce/2]=9;
+        return true;
+    }
+    return false;
 }
 
